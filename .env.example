# API Configuration
# NUXT_PUBLIC_API_BASE_URL=https://metrobnb-api.onrender.com  # Production
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development Settings
NUXT_PUBLIC_DEV_MODE=false
NUXT_DEVTOOLS=true
# Force cache bust
CACHE_BUST=1

# Cache Settings (in minutes)
CACHE_DURATION_MINUTES=5

# API Warmup Settings (for Render cold starts)
NUXT_PUBLIC_WARMUP_ENABLED=true
NUXT_PUBLIC_WARMUP_TIMEOUT=60000        # 60 seconds for Render cold starts
NUXT_PUBLIC_WARMUP_INTERVAL=10          # Ping every 10 minutes
NUXT_PUBLIC_WARMUP_INITIAL_DELAY=5000   # Wait 5 seconds after app loads

